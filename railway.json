{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "python manage.py collectstatic --noinput"
  },
  "deploy": {
    "startCommand": "python manage.py migrate && gunicorn barrs_store.wsgi --workers 4 --timeout 120 --bind 0.0.0.0:$PORT --log-file - --access-logfile - --max-requests 1000 --max-requests-jitter 100",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
