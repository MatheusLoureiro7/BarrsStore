# Garante linha Unix (LF) em todos os arquivos de texto
* text=auto eol=lf

# Python
*.py text eol=lf

# Templates e configs
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env text eol=lf

# Binários — não converter
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
